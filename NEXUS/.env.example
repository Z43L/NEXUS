# Local development template. Copy to .env and replace every value.
# Generate password values from alphanumeric characters because the AGE init
# script interpolates the database password in a SQL literal.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
OPENAI_API_KEY=replace-with-your-provider-key
OPENROUTER_API_KEY=replace-with-your-provider-key
MEMORY_API_KEY=replace-with-a-long-random-secret
