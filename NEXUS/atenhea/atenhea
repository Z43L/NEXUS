#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$SCRIPT_DIR/build/atenhea" ]; then
  exec "$SCRIPT_DIR/build/atenhea" "$@"
fi
if [ -n "${ONRAM_PYTHON:-}" ]; then
  PYTHON=$ONRAM_PYTHON
elif [ -x "$SCRIPT_DIR/.venv/bin/python" ]; then
  PYTHON=$SCRIPT_DIR/.venv/bin/python
elif [ -x "$SCRIPT_DIR/../../.venv-gemma4/bin/python" ]; then
  PYTHON=$SCRIPT_DIR/../../.venv-gemma4/bin/python
else
  PYTHON=python3
fi
exec "$PYTHON" "$SCRIPT_DIR/onram_cli.py" "$@"
