# Copy to .env.h0, then edit ATENHEA_URL and NEXUS_UID/GID if needed.
# This is the Atenhea ENGINE API, not the agent proxy at :11434.
# Docker Desktop: http://host.docker.internal:11436
# Linux host:     http://host.docker.internal:11436 (Compose maps host-gateway)
ATENHEA_URL=http://host.docker.internal:11436

# Bootstrap script writes your current UID/GID into .env.h0.
NEXUS_UID=1000
NEXUS_GID=1000

# Must fit inside NEXUS_H0_SUBNET and not overlap an existing route/network.
NEXUS_H0_SUBNET=172.30.240.0/24
NEXUS_ROUTER_IP=172.30.240.2
ROUTER_HOST_PORT=18090

# Optional node EVM identity. This is not a private key.
NEXUS_H1_WALLET=
