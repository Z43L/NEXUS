# Copy to .env.h0, then edit ATENHEA_URL and NEXUS_UID/GID if needed.
# This is the Atenhea ENGINE API, not the agent proxy at :11434.
# Atenhea fuera de loopback exige HTTPS con certificado confiable y API key.
# El worker solo acepta HTTP para loopback o un servicio de mock explícitamente permitido.
ATENHEA_URL=https://host.docker.internal:11436

# Bootstrap script writes your current UID/GID into .env.h0.
NEXUS_UID=1000
NEXUS_GID=1000

API_HOST_PORT=8000
UI_HOST_PORT=8080

# Exact browser origins allowed to sign in. Use HTTPS behind a trusted ingress.
NEXUS_AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Active worker/model discovery timeout (heartbeat interval is 5 seconds).
# Accepted range: 10–3600 seconds.
NEXUS_H0_NODE_HEARTBEAT_TTL_SECONDS=30

# Optional node EVM identity. This is not a private key.
NEXUS_H1_WALLET=
